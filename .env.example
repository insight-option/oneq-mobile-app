# Copy to .env (never commit .env). Values prefixed EXPO_PUBLIC_ are embedded in the JS bundle.

# Data mode: "mock" (offline seeded data, OTP 123456) or "amplify" (real backend; needs amplify_outputs.json from `npx ampx sandbox`).
# EXPO_PUBLIC_DATA_MODE=mock   # leave unset to auto-detect: amplify when amplify_outputs.json exists, mock otherwise

# Google Maps SDK for Android key (Maps SDK for Android enabled, restricted to package com.mastajazz.oneQapp + SHA-1).
# Without it the Android map falls back to CARTO raster tiles. iOS uses Apple Maps and needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=

# EAS project id (from `npx eas-cli init`), required for Expo push tokens.
EAS_PROJECT_ID=

# Optional: Expo push notifications are sent server-side by the Amplify functions. WhatsApp Cloud API secrets are set with
# `npx ampx sandbox secret set WHATSAPP_TOKEN` and `... WHATSAPP_PHONE_ID` (see docs/RUNBOOK.md).

# Optional public media base URL (CloudFront/S3 website in front of the Amplify bucket). When unset the app signs S3 URLs on read.
EXPO_PUBLIC_MEDIA_BASE_URL=
