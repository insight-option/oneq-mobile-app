{
  "expo": {
    "name": "OneQ",
    "slug": "oneQ-app",
    "scheme": "oneq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#5A0020",
    "newArchEnabled": true,
    "primaryColor": "#5A0020",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mastajazz.oneq",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "OneQ",
        "NSCameraUsageDescription": "OneQ يحتاج الكاميرا لرفع صور الشركة والموظفين. OneQ needs the camera to upload company and staff photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5A0020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mastajazz.oneQapp",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "lang": "ar",
      "themeColor": "#5A0020",
      "backgroundColor": "#5A0020",
      "description": "OneQ — منصة الخدمات الأولى في قطر"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "./plugins/withNativeRtl",
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5A0020",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IBMPlexSansArabic-Regular.ttf",
            "./assets/fonts/IBMPlexSansArabic-Medium.ttf",
            "./assets/fonts/IBMPlexSansArabic-SemiBold.ttf",
            "./assets/fonts/IBMPlexSansArabic-Bold.ttf",
            "./assets/fonts/Outfit-Regular.ttf",
            "./assets/fonts/Outfit-Medium.ttf",
            "./assets/fonts/Outfit-SemiBold.ttf",
            "./assets/fonts/Outfit-Bold.ttf",
            "./assets/fonts/PlayfairDisplay-SemiBold.ttf",
            "./assets/fonts/PlayfairDisplay-Bold.ttf"
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5A0020",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم OneQ موقعك لعرض أقرب الشركات والخدمات إليك. OneQ uses your location to show the nearest companies and services.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج OneQ الوصول إلى الصور لرفع الشعار والصور. OneQ needs photo access to upload logos and pictures.",
          "cameraPermission": "يحتاج OneQ الكاميرا لالتقاط الصور. OneQ needs the camera to take pictures."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d5503d5b-5dca-458b-9b21-72b2e99c2b54"
      }
    }
  }
}
